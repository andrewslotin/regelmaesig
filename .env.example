# Copy to .env and fill in real values from your Grafana Cloud stack's
# "Details" page (Prometheus and Tempo panels). Used by docker-compose.yml
# and alloy/config.alloy.

# Prometheus remote_write endpoint URL, e.g.
# https://prometheus-prod-xx-xxxx.grafana.net/api/prom/push
GRAFANA_CLOUD_PROM_URL=https://prometheus-prod-xx-xxxx.grafana.net/api/prom/push

# Prometheus instance ID, used as basic auth username for remote_write.
GRAFANA_CLOUD_PROM_USER=123456

# Tempo OTLP base URL, e.g.
# https://otlp-gateway-prod-xx-xxxx.grafana.net/otlp
GRAFANA_CLOUD_TEMPO_URL=https://otlp-gateway-prod-xx-xxxx.grafana.net/otlp

# Tempo instance ID, used as basic auth username for the OTLP exporter.
GRAFANA_CLOUD_TEMPO_USER=654321

# Grafana Cloud API token, used as basic auth password for both Prometheus
# and Tempo above.
GRAFANA_CLOUD_API_KEY=glc_your_api_token_here

# Optional: HAFAS mgate.exe fallback (see README). Leave unset to disable.
HAFAS_ENDPOINT=
HAFAS_AUTH_AID=
HAFAS_VERSION=

# Optional: OpenTelemetry trace sampler argument (e.g. sampling ratio for
# traceidratio sampler). Leave unset to use the app's default sampler.
OTEL_TRACES_SAMPLER_ARG=
